  "tutorials": [
    {
      "x": 300,
      "text": "A / D  walk     ·     SPACE  jump     ·     SHIFT  run"
    },
    {
      "x": 760,
      "text": "Hold E to search. Moving away or letting go interrupts the task."
    },
    {
      "x": 2670,
      "text": "The gate has a hand wheel. Stand beside it and press E."
    },
    {
      "x": 3980,
      "text": "Rest at a fire. One ration restores food, warmth and strength."
    },
    {
      "x": 2130,
      "text": "Hold E and move against the crate to push. Climb it to reach the wall."
    },
    {
      "x": 1250,
      "text": "Hold SHIFT across a long gap. Release SPACE early for a short jump."
    },
    {
      "x": 6760,
      "text": "Some things need four hands. Bring him close, then hold E at the bar."
    },
    {
      "x": 7380,
      "text": "Listen to the branches. Wait in the wall’s lee until the gust passes."
    },
    {
      "x": 10100,
      "text": "The roof creaks before it falls. Brace it with salvage, or wait for a quiet moment."
    },
    {
      "x": 11810,
      "text": "The bank is exposed. A fast crossing spends strength; a low crossing waits out the wind."
    },
    {
      "x": 14050,
      "text": "There is wire for one repair. Keep it, or spend it here and make the roof safe for him."
    }
  ],
