  "memories": [
    {
      "x": 1890,
      "y": 540,
      "id": "lesson",
      "text": "Tomorrow, the teacher had written. Nothing after that."
    },
    {
      "x": 4600,
      "y": 600,
      "id": "shoe",
      "text": "A small shoe beside the road. She turned him away from it."
    },
    {
      "x": 6110,
      "y": 630.0,
      "id": "coathooks",
      "text": "Small coats hung from the hooks. The sleeves waited for hands."
    },
    {
      "x": 8810,
      "y": 630.0,
      "id": "small_chair",
      "text": "He straightened a chair. Then another. She waited by the door."
    },
    {
      "x": 10000,
      "y": 600.55,
      "id": "lesson_after_rain",
      "text": "On a dry scrap: after the rain, draw what you see."
    },
    {
      "x": 11960,
      "y": 660.0,
      "id": "arcade_cooking_marks",
      "text": "Pencil marks beside the kitchen door measured someone growing taller."
    },
    {
      "x": 13330,
      "y": 475,
      "id": "arcade_sun_paper",
      "text": "A yellow paper sun. There was still a fold where it had been held."
    },
    {
      "x": 14680,
      "y": 607.556,
      "id": "greenhouse_soil",
      "text": "He brushed the broken glass away from a little square of soil."
    }
  ],
