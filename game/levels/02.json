  "memories": [
    {
      "x": 1590,
      "y": 600,
      "id": "birds",
      "text": "They listened. The trees held no birds."
    },
    {
      "x": 4390,
      "y": 538,
      "id": "drawing",
      "text": "A house, two windows, a sun. Someone had folded it carefully."
    },
    {
      "x": 6550,
      "y": 547.47,
      "id": "white_threads",
      "text": "White threads on the thorns. Someone else had come this way."
    },
    {
      "x": 9370,
      "y": 663.94,
      "id": "half_map",
      "text": "The paper showed a road. The water had taken the names."
    },
    {
      "x": 11750,
      "y": 657.0,
      "id": "canal_rope",
      "text": "The rope was worn smooth where many hands had held it."
    },
    {
      "x": 12890,
      "y": 475,
      "id": "canal_ledger_memory",
      "text": "A name, a date, a small drawing of a boat. She kept the page dry."
    },
    {
      "x": 14320,
      "y": 599.543,
      "id": "signal_left_on",
      "text": "The lamp had been left on. Someone had expected to return before dark."
    },
    {
      "x": 16070,
      "y": 636.0,
      "id": "mill_fence_marks",
      "text": "The marks on the fence were worn by hands waiting for the wheel to turn."
    },
    {
      "x": 18050,
      "y": 636.0,
      "id": "mill_chain_silence",
      "text": "The chain fell quiet behind them. He waited for the sound to end before letting go."
    }
  ],
