  "memories": [
    {
      "x": 2150,
      "y": 544,
      "id": "sun",
      "text": "He drew the sun even after he had forgotten its warmth."
    },
    {
      "x": 3890,
      "y": 540,
      "id": "hand",
      "text": "The hand that pulled him into play was the hand that would not let go."
    },
    {
      "x": 6610,
      "y": 567.47,
      "id": "garden_seedlings",
      "text": "There were green things under the ash. He knelt to make sure."
    },
    {
      "x": 8670,
      "y": 630.0,
      "id": "two_cups",
      "text": "Two cups on a sill. One much smaller than the other."
    },
    {
      "x": 9890,
      "y": 586.0,
      "id": "blue_thread",
      "text": "The ribbon was almost grey. She tied it twice again."
    },
    {
      "x": 11280,
      "y": 570.71,
      "id": "terrace_first_leaf",
      "text": "The green was too small to see from the road. He had seen it first."
    },
    {
      "x": 12740,
      "y": 674.0,
      "id": "terrace_water",
      "text": "He cupped his hands below the slow drip. She waited until they were steady."
    },
    {
      "x": 13860,
      "y": 594.2,
      "id": "terrace_ribbon",
      "text": "She tied the ribbon twice. This time he held the ends."
    }
