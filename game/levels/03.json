  "tutorials": [
    {
      "x": 450,
      "text": "The light can find either of you. Keep both children low, behind solid cover."
    },
    {
      "x": 1850,
      "text": "A moving light sweeps the camp. Crouch behind walls and tents."
    },
    {
      "x": 4500,
      "text": "Search the camp for salvage. The shelter needs two pieces."
    },
    {
      "x": 4880,
      "text": "The shelter leaks. Salvage for the roof, or save it. Hold E at the damaged beam."
    },
    {
      "x": 7710,
      "text": "The beams give a warning. Keep him under cover while you decide how to cross."
    },
    {
      "x": 9990,
      "text": "The light returns to the same place. Let it pass, then take him with you."
    },
    {
      "x": 13880,
      "text": "Four hands can turn the signal away. Or wait for the light and cross while it is gone."
    }
  ],
