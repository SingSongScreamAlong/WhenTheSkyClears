    },
    {
      "x": 9310,
      "y": 630.0,
      "id": "waiting_bench",
      "text": "A folded coat on a bench. It still held the shape of waiting."
    },
    {
      "x": 12650,
      "y": 572.0,
      "id": "signal_whistle",
